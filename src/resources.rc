#include "windows.h"
#include "resources.h"

// Application icon
IDI_APPICON ICON "../no-sleeping_9260684.ico"

// Version info (optional)
VS_VERSION_INFO VERSIONINFO
FILEVERSION     @VERSION_COMMA@
PRODUCTVERSION  @VERSION_COMMA@
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "nosleep"
            VALUE "FileDescription", "Prevent Windows from sleeping"
            VALUE "FileVersion", "@VERSION_STRING@.0"
            VALUE "InternalName", "nosleep"
            VALUE "LegalCopyright", "GPL v3"
            VALUE "OriginalFilename", "nosleep.exe"
            VALUE "ProductName", "nosleep"
            VALUE "ProductVersion", "@VERSION_STRING@.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

IDD_DOWNLOAD_SIZE_ERROR DIALOGEX 0, 0, 380, 136
STYLE DS_MODALFRAME | DS_SETFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_TOPMOST
CAPTION "Download Failed"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "", IDC_DOWNLOAD_SIZE_MESSAGE, 10, 10, 360, 78
    DEFPUSHBUTTON "Open release page", IDC_DOWNLOAD_SIZE_OPEN_RELEASE, 164, 102, 112, 18
    PUSHBUTTON "Close", IDCANCEL, 286, 102, 78, 18
END

// Update choices stay available while the user reads release notes in the browser.
IDD_UPDATE_PROMPT DIALOGEX 0, 0, 290, 115
STYLE DS_MODALFRAME | DS_SETFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_TOPMOST
CAPTION "Update Available - nosleep"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "", IDC_UPDATE_MESSAGE, 10, 10, 270, 66
    PUSHBUTTON "Release notes", IDC_UPDATE_NOTES, 10, 88, 78, 16
    DEFPUSHBUTTON "Install update", IDYES, 112, 88, 82, 16
    PUSHBUTTON "Later", IDCANCEL, 202, 88, 78, 16
END
